{
  "name": "blamely",
  "displayName": "Blamely",
  "description": "Track AI vs human code attribution line by line. Requires the blamely CLI. https://blamely.ai",
  "version": "1.1.6",
  "license": "MIT",
  "icon": "images/icon.png",
  "publisher": "blamely",
  "repository": {
    "type": "git",
    "url": "https://github.com/blamely-ai/vscode-plugin.git"
  },
  "homepage": "https://blamely.ai",
  "bugs": {
    "url": "https://github.com/blamely-ai/vscode-plugin/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "ai",
    "git",
    "blame",
    "attribution",
    "blamely"
  ],
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "clean:out": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});\"",
    "vscode:prepublish": "npm run clean:out && npm run compile:release && npm run obfuscate",
    "compile": "tsc -p ./",
    "compile:release": "tsc -p ./tsconfig.release.json",
    "obfuscate": "node scripts/obfuscate-out.cjs",
    "vsix": "npm run vscode:prepublish && npx @vscode/vsce package --no-dependencies",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "mocha --require ts-node/register 'src/test/**/*.test.ts' --timeout 10000"
  },
  "contributes": {
    "commands": [
      {
        "command": "blamely.refresh",
        "title": "Blamely: Refresh Runtime Data",
        "category": "Blamely"
      },
      {
        "command": "blamely.showBlame",
        "title": "Blamely: Show Blame for Current File",
        "category": "Blamely"
      },
      {
        "command": "blamely.showDaemonStatus",
        "title": "Blamely: Show Daemon Status",
        "category": "Blamely"
      },
      {
        "command": "blamely.signalInlineAccept",
        "title": "Blamely: Signal Inline Completion Accepted",
        "category": "Blamely",
        "enablement": "never"
      }
    ],
    "keybindings": [
      {
        "key": "tab",
        "command": "runCommands",
        "args": {
          "commands": [
            "blamely.signalInlineAccept",
            "editor.action.inlineSuggest.commit"
          ]
        },
        "when": "inlineSuggestionVisible && !editorReadonly"
      },
      {
        "key": "cmd+right",
        "command": "runCommands",
        "args": {
          "commands": [
            "blamely.signalInlineAccept",
            "editor.action.inlineSuggest.acceptNextWord"
          ]
        },
        "when": "inlineSuggestionVisible && !editorReadonly && isMac"
      },
      {
        "key": "ctrl+right",
        "command": "runCommands",
        "args": {
          "commands": [
            "blamely.signalInlineAccept",
            "editor.action.inlineSuggest.acceptNextWord"
          ]
        },
        "when": "inlineSuggestionVisible && !editorReadonly && !isMac"
      }
    ],
    "configuration": {
      "title": "Blamely",
      "properties": {
        "blamely.showGutterDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show attribution gutter icons and hovers in the editor (from oobeya-cli runtime data)"
        },
        "blamely.detectInlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Detect inline AI completion accepts (Cursor Tab, Copilot Tab) by observing document changes and post them to the blamely daemon as gen_type=completion events."
        },
        "blamely.aiTool": {
          "type": "string",
          "enum": ["auto", "copilot", "cursor"],
          "default": "auto",
          "markdownDescription": "Which AI tool to credit for edits this extension detects. `auto` infers from the host editor (VS Code with the GitHub Copilot extension → Copilot; Cursor → Cursor). Set this explicitly when you run **GitHub Copilot inside Cursor** (or Cursor Tab inside VS Code) so chat applies and inline completions are attributed to the right tool. Copilot and Cursor are tracked as fully independent tools."
        },
        "blamely.debugDetection": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log AI-edit detection to the **Blamely** output channel: every executed command id, each chat-apply/inline-accept match, and each recorded edit (tool, gen_type, line range). Use this to verify attribution and to discover the chat-apply command id your editor/version uses."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "blamelySidebar",
          "name": "Blamely: Changes",
          "type": "webview"
        },
        {
          "id": "blamelyHistory",
          "name": "Blamely: History",
          "type": "webview"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "chai": "^4.4.1",
    "eslint": "^8.56.0",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "javascript-obfuscator": "^4.1.1"
  }
}
